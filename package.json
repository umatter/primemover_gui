{
  "name": "primemover-frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build.prod": "ng build --configuration production",
    "build.test": "ng build --configuration testing",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint.check": "ng lint && stylelint \"src/**/*.scss\"",
    "lint": "ng lint && stylelint \"src/**/*.scss\" --fix",
    "test.ci": "ng test --browsers=ChromeHeadlessNoSandbox --watch=false --code-coverage=true",
    "format": "prettier --write .",
    "format.check": "prettier --check ."
  },
  "license": "MIT",
  "private": true,
