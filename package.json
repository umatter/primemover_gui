    "@angular/material": "^17.3",
    "@angular/platform-browser": "^17.3",
    "@angular/platform-browser-dynamic": "^17.3",
    "@angular/router": "^17.3",
    "@ngrx/data": "^17.2",
    "@ngrx/effects": "^17.2",
